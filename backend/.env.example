# Configuración del backend para DESARROLLO LOCAL.
#
#   cp .env.example .env
#
# Con estos valores anda tal cual en local (docker compose + uvicorn en tu
# máquina). El .env nunca se sube a git. Para producción se usa
# deploy/.env.example (ver DEPLOY.md), no este archivo.
#
# Toda variable que no esté en el .env toma el default de app/core/config.py.

# --- App ---
# local | test | staging | production (production exige SECRET_KEY propia y
# apaga /docs).
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
# Orígenes del frontend que pueden llamar a la API (formato JSON).
CORS_ORIGINS=["http://localhost:4200"]

# --- Postgres ---
# Usados tanto por docker-compose (para crear el contenedor) como por la API
# (para conectarse). Si corrés la API fuera de Docker, dejá POSTGRES_HOST=localhost.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce
POSTGRES_HOST=localhost
# Cambialo si ya tenés otro Postgres usando el 5432 (ej. uno de Homebrew).
POSTGRES_PORT=5432
# Solo para proveedores managed con TLS (Neon, Supabase...): require. En local, vacío.
POSTGRES_SSLMODE=
# Alternativa a los POSTGRES_* de arriba: pegá tal cual la connection string
# de un proveedor managed y pisa todo lo demás.
# DATABASE_URL=postgresql+psycopg://user:pass@host/db?sslmode=require

# --- pgAdmin (solo docker-compose) ---
# http://localhost:5050 — para conectarte a la base desde pgAdmin, host: postgres
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# --- Auth / JWT ---
# En local sirve este valor. Para una propia:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-.env-this-is-not-secure
# Duración de la sesión (1440 = 1 día).
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Límite de intentos en login/registro/olvidé mi contraseña. Ponelo en false
# si te molesta mientras probás.
RATE_LIMIT_ENABLED=true

# --- URLs ---
# Dónde corre el frontend (para el link del email de "olvidé mi contraseña").
FRONTEND_URL=http://localhost:4200
# Dónde corre la API (para armar la URL absoluta de las imágenes de producto).
BACKEND_PUBLIC_URL=http://localhost:8000

# --- Imágenes de producto ---
# Tamaño máximo de cada imagen que sube el admin.
MAX_IMAGE_SIZE_MB=5

# --- SMTP (emails de "olvidé mi contraseña" y de pedidos) ---
# Si dejás SMTP_HOST vacío, el backend no manda el mail: loguea el link de
# reseteo en la consola, útil para probar el flujo en local sin credenciales
# reales. Ejemplo con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=tu-cuenta@gmail.com, SMTP_PASSWORD=<contraseña de aplicación>.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=no-reply@vaconyapa.com.ar

# --- Tienda ---
# Nombre que aparece en los emails.
STORE_NAME=VACONYAPA
# Casilla que recibe un aviso por cada pedido nuevo (vacío = sin aviso por mail;
# el pedido igual aparece en /admin/pedidos). Necesita SMTP configurado.
ORDER_NOTIFY_EMAIL=
