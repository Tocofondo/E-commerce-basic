# Copiar a .env y ajustar valores antes de levantar docker-compose / la API.

# --- App ---
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:4200"]

# --- Postgres ---
# Usados tanto por docker-compose (para crear el contenedor) como por la API
# (para conectarse). Si corrés la API fuera de Docker, dejá POSTGRES_HOST=localhost.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Requerido por proveedores managed con TLS (Neon, Supabase, Render Postgres...).
POSTGRES_SSLMODE=
# Alternativa a los POSTGRES_* de arriba: pega tal cual la connection string
# de un proveedor managed (ej. Neon) y pisa todo lo demás.
# DATABASE_URL=postgresql+psycopg://user:pass@host/db?sslmode=require

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# --- Auth / JWT ---
# Generar una propia, por ejemplo con: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-.env-this-is-not-secure
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Frontend (para armar el link del email de "olvidé mi contraseña") ---
FRONTEND_URL=http://localhost:4200

# --- SMTP (email de "olvidé mi contraseña") ---
# Si dejás SMTP_HOST vacío, el backend no manda el mail: loguea el link de
# reseteo en la consola, útil para probar el flujo en local sin credenciales
# reales. Ejemplo con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=tu-cuenta@gmail.com, SMTP_PASSWORD=<app password>.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=no-reply@mitienda.com
