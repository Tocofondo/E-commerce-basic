# Copiar a .env y ajustar valores antes de levantar docker-compose / la API.

# --- App ---
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:4200"]

# --- Postgres ---
# Usados tanto por docker-compose (para crear el contenedor) como por la API
# (para conectarse). Si corrés la API fuera de Docker, dejá POSTGRES_HOST=localhost.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# --- Auth / JWT ---
# Generar una propia, por ejemplo con: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-.env-this-is-not-secure
ACCESS_TOKEN_EXPIRE_MINUTES=1440
