# Configuración de producción. Copiar a deploy/.env (nunca se sube a git) y
# completar TODO lo marcado. Ver DEPLOY.md.

# --- Dominio ---
# Con dominio: SITE_ADDRESS=mitienda.com.ar y PUBLIC_URL=https://mitienda.com.ar
#   (Caddy saca el certificado HTTPS solo; el DNS tiene que apuntar a la IP
#   del servidor ANTES de levantar el stack).
# Sin dominio todavía (solo para probar, HTTP plano):
#   SITE_ADDRESS=:80 y PUBLIC_URL=http://<IP-del-servidor>
SITE_ADDRESS=mitienda.com.ar
PUBLIC_URL=https://mitienda.com.ar

# --- Postgres ---
# Contraseña larga y aleatoria, por ejemplo: openssl rand -base64 32 | tr -d '/+='
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=CAMBIAR
POSTGRES_DB=ecommerce

# --- Auth / JWT ---
# OBLIGATORIO: la API no arranca en producción con el valor por defecto.
# Generar con: openssl rand -base64 48 | tr -d '/+='
SECRET_KEY=CAMBIAR
ACCESS_TOKEN_EXPIRE_MINUTES=1440

LOG_LEVEL=INFO

# --- SMTP (email de "olvidé mi contraseña") ---
# Si SMTP_HOST queda vacío no se manda el mail: el link de reseteo solo
# aparece en los logs del backend (docker compose logs backend).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=tu-cuenta@gmail.com,
# SMTP_PASSWORD=<contraseña de aplicación>, SMTP_FROM=tu-cuenta@gmail.com.
# AWS SES también sirve (SMTP_HOST=email-smtp.<región>.amazonaws.com).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=no-reply@mitienda.com.ar
